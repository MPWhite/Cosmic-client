diff --git a/tests/king_slime_test.cpp b/tests/king_slime_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/king_slime_test.cpp
@@ -0,0 +1,38 @@
+#include <doctest/doctest.h>
+#include "support/assets.h"
+#include "client/Gameplay/MapleMap/MobAttackTimeline.h"
+
+TEST_CASE("KPQ King Slime attack metadata agrees with the playable slam")
+{
+    const test_support::NxFile mobs("Mob.nx");
+    const auto attack = mobs.root()["9300003.img"]["attack1"];
+    const auto info = attack["info"];
+    REQUIRE(attack["0"].data_type() == nl::node::type::bitmap);
+    CHECK(info["attackAfter"].get_integer() == 900);
+    CHECK(info["effectAfter"].get_integer() == 300);
+    CHECK(info["PADamage"].get_integer() == 165);
+    CHECK(info["jumpAttack"].get_bool());
+    const jrc::Rectangle<int16_t> range(info["range"]);
+    CHECK(range.l() == -250);
+    CHECK(range.r() == 250);
+    CHECK(range.t() == -150);
+    CHECK(range.b() == 0);
+    int duration = 0, frames = 0;
+    for (auto frame : attack)
+    {
+        if (frame.data_type() == nl::node::type::bitmap)
+        {
+            ++frames;
+            duration += frame["delay"].get_integer(100);
+        }
+    }
+    CHECK(frames == 8);
+    CHECK(duration == 1500);
+    jrc::MobAttackTimeline timeline;
+    timeline.configure(info["attackAfter"].get_integer(), duration);
+    REQUIRE(timeline.start());
+    timeline.update(899);
+    CHECK_FALSE(timeline.take_impact());
+    timeline.update(1);
+    CHECK(timeline.take_impact());
+}
diff --git a/tests/mob_attack_test.cpp b/tests/mob_attack_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/mob_attack_test.cpp
@@ -0,0 +1,111 @@
+#include <doctest/doctest.h>
+#include "client/Gameplay/MapleMap/MobAttackTimeline.h"
+
+using jrc::MobAttackTimeline;
+using jrc::Point;
+using jrc::Rectangle;
+
+TEST_CASE("King Slime's windup deals one impact at the WZ delay")
+{
+    MobAttackTimeline attack;
+    attack.configure(900, 1500);
+    REQUIRE(attack.start());
+    for (int tick = 0; tick < 112; ++tick)
+    {
+        attack.update(8);
+        CHECK_FALSE(attack.take_impact());
+    }
+    attack.update(8);
+    CHECK(attack.take_impact());
+    CHECK_FALSE(attack.take_impact());
+    CHECK(attack.is_active());
+    CHECK_FALSE(attack.start());
+    attack.update(596);
+    CHECK_FALSE(attack.is_active());
+    CHECK_FALSE(attack.take_impact());
+}
+
+TEST_CASE("Invulnerability cannot defer a missed stomp into a later hit")
+{
+    MobAttackTimeline attack;
+    attack.configure(900, 1500);
+    REQUIRE(attack.start());
+    attack.update(904); // invulnerable player does not consume this impact
+    attack.update(8);
+    CHECK_FALSE(attack.take_impact());
+    CHECK(attack.is_active());
+}
+
+TEST_CASE("Monster death cancels an attack during its windup")
+{
+    MobAttackTimeline attack;
+    attack.configure(900, 1500);
+    REQUIRE(attack.start());
+    attack.update(800);
+    attack.cancel();
+    attack.update(200);
+    CHECK_FALSE(attack.take_impact());
+    CHECK_FALSE(attack.is_active());
+}
+
+TEST_CASE("King Slime's ground slam respects range, floors, and jump dodges")
+{
+    const auto range = MobAttackTimeline::world_range({-250, 250, -150, 0}, {100, -435}, false);
+    CHECK(MobAttackTimeline::hits(range, {340, -435}, true, true));
+    CHECK_FALSE(MobAttackTimeline::hits(range, {363, -435}, true, true));
+    CHECK_FALSE(MobAttackTimeline::hits(range, {100, -743}, true, true));
+    CHECK_FALSE(MobAttackTimeline::hits(range, {100, -470}, true, false));
+    CHECK(MobAttackTimeline::hits(range, {100, -470}, false, false));
+}
+
+TEST_CASE("Directional WZ hit boxes mirror around monster feet")
+{
+    const Rectangle<int16_t> local{-180, 40, -90, 0};
+    const auto left = MobAttackTimeline::world_range(local, {100, 30}, false);
+    const auto right = MobAttackTimeline::world_range(local, {100, 30}, true);
+    CHECK(left.l() == -80);
+    CHECK(left.r() == 140);
+    CHECK(right.l() == 60);
+    CHECK(right.r() == 280);
+    CHECK(right.t() == -60);
+    CHECK(right.b() == 30);
+}
+
+#include "client/Net/InPacket.h"
+#include "client/Net/Packets/GameplayPackets.h"
+#include "client/Net/Packets/AttackAndSkillPackets.h"
+
+TEST_CASE("King Slime attack packets retain v83 action and physical movement fields")
+{
+    const jrc::Movement movement(jrc::Movement::_ABSOLUTE, 0, 100, -435, 0, 0, 19, 4, 1);
+    const jrc::MoveMobPacket packet(123, 1, 0, 24, 0, 0, 0, 0, {100, -435}, movement);
+    jrc::InPacket input(packet.data().data() + 2, packet.data().size() - 2);
+    CHECK(input.read_int() == 123);
+    CHECK(input.read_short() == 1);
+    CHECK(input.read_byte() == 0);
+    CHECK(input.read_byte() == 24); // attack1 wire byte, decoded action12
+    input.skip(17); // skill fields, options, and reserved movement preamble
+    CHECK(input.read_point() == Point<int16_t>(100, -435));
+    CHECK(input.read_byte() == 1);
+    CHECK(input.read_byte() == 0);
+    CHECK(input.read_point() == Point<int16_t>(100, -435));
+    input.skip(4);
+    CHECK(input.read_short() == 19);
+    CHECK(input.read_byte() == 4); // animation is separate from ground stance
+    CHECK(input.read_short() == 1);
+    CHECK_FALSE(input.available());
+}
+
+TEST_CASE("Slam damage reports ordinary attack index zero rather than contact")
+{
+    const jrc::TakeDamagePacket packet(0, 0, 97, 9300003, 123, 1);
+    jrc::InPacket input(packet.data().data() + 2, packet.data().size() - 2);
+    input.skip(4); // client timestamp
+    CHECK(input.read_byte() == 0);
+    CHECK(input.read_byte() == 0);
+    CHECK(input.read_int() == 97);
+    CHECK(input.read_int() == 9300003);
+    CHECK(input.read_int() == 123);
+    CHECK(input.read_byte() == 1);
+    CHECK_FALSE(input.available());
+}
