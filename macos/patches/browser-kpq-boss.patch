diff --git a/src/client/Gameplay/MapleMap/MobAttackTimeline.h b/src/client/Gameplay/MapleMap/MobAttackTimeline.h
new file mode 100644
--- /dev/null
+++ b/src/client/Gameplay/MapleMap/MobAttackTimeline.h
@@ -0,0 +1,69 @@
+#pragma once
+#include "../../Template/Rectangle.h"
+#include <algorithm>
+#include <cstdint>
+
+namespace jrc
+{
+    // WZ attackAfter and frame delays use milliseconds. An impact is available
+    // for precisely one simulation step, even if the player is invulnerable.
+    class MobAttackTimeline
+    {
+    public:
+        void configure(int32_t impact_delay, int32_t duration)
+        {
+            impact_after = std::max(1, impact_delay);
+            animation_duration = std::max(impact_after, duration);
+        }
+
+        bool start()
+        {
+            if (active || impact_after <= 0) return false;
+            elapsed = 0;
+            active = true;
+            impact = false;
+            return true;
+        }
+
+        void update(int32_t milliseconds)
+        {
+            impact = false;
+            if (!active || milliseconds <= 0) return;
+            const int32_t previous = elapsed;
+            elapsed += milliseconds;
+            impact = previous < impact_after && elapsed >= impact_after;
+            if (elapsed >= animation_duration) active = false;
+        }
+
+        void cancel() { active = false; impact = false; }
+        bool is_active() const { return active; }
+        bool take_impact()
+        {
+            const bool result = impact;
+            impact = false;
+            return result;
+        }
+
+        static Rectangle<int16_t> world_range(Rectangle<int16_t> range,
+            Point<int16_t> origin, bool facing_right)
+        {
+            if (facing_right) range = {-range.r(), -range.l(), range.t(), range.b()};
+            range.shift(origin);
+            return range;
+        }
+
+        static bool hits(const Rectangle<int16_t>& range, Point<int16_t> feet,
+            bool ground_attack, bool grounded)
+        {
+            if (ground_attack && !grounded) return false;
+            return range.overlaps({feet.x() - 12, feet.x() + 12, feet.y() - 48, feet.y()});
+        }
+
+    private:
+        int32_t impact_after = 0;
+        int32_t animation_duration = 0;
+        int32_t elapsed = 0;
+        bool active = false;
+        bool impact = false;
+    };
+}
