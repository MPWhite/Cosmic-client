new file mode 100644
index 0000000..fefa707
--- /dev/null
+++ b/tests/viewport_camera_test.cpp
@@ -0,0 +1,69 @@
+#include <doctest/doctest.h>
+
+#include "client/Constants.h"
+#include "client/Gameplay/Camera.h"
+
+namespace
+{
+    struct RestoreViewport
+    {
+        ~RestoreViewport()
+        {
+            jrc::Constants::set_viewsize(jrc::Constants::VIEWWIDTH, jrc::Constants::VIEWHEIGHT);
+        }
+    };
+}
+
+TEST_CASE("Camera rotation centers the player immediately without interpolating old screen coordinates")
+{
+    RestoreViewport restore;
+    jrc::Constants::set_viewsize(800, 600);
+    jrc::Camera camera;
+    camera.set_view({-3000, 3000}, {-3000, 3000});
+    camera.set_position({100, 200});
+    camera.update({100, 200});
+
+    for (const auto size : {jrc::Point<int16_t>(1400, 600), jrc::Point<int16_t>(800, 1600), jrc::Point<int16_t>(800, 600)})
+    {
+        jrc::Constants::set_viewsize(size.x(), size.y());
+        camera.update({100, 200});
+        const auto expected = jrc::Point<int16_t>(size.x() / 2 - 100, size.y() / 2 - 200);
+        CHECK(camera.position() == expected);
+        CHECK(camera.position(0.0f) == expected);
+        CHECK(camera.position(0.5f) == expected);
+    }
+}
+
+TEST_CASE("Camera centers maps smaller than an expanded viewport")
+{
+    RestoreViewport restore;
+    jrc::Constants::set_viewsize(800, 600);
+    jrc::Camera camera;
+    camera.set_view({100, 900}, {200, 800});
+    camera.set_position({500, 500});
+
+    jrc::Constants::set_viewsize(1400, 1600);
+    camera.update({500, 500});
+    CHECK(camera.position() == jrc::Point<int16_t>(200, 300));
+    CHECK(camera.position() + jrc::Point<int16_t>(500, 500) == jrc::Point<int16_t>(700, 800));
+
+    // Walking to the edge of a small map must not pull it out of the center.
+    camera.update({100, 200});
+    CHECK(camera.position() == jrc::Point<int16_t>(200, 300));
+}
+
+TEST_CASE("An expanded camera still clamps to both edges of a large map")
+{
+    RestoreViewport restore;
+    jrc::Constants::set_viewsize(1400, 600);
+    jrc::Camera camera;
+    camera.set_view({0, 3000}, {0, 2000});
+
+    camera.set_position({0, 0});
+    camera.update({0, 0});
+    CHECK(camera.position() == jrc::Point<int16_t>(0, 0));
+
+    camera.set_position({3000, 2000});
+    camera.update({3000, 2000});
+    CHECK(camera.position() == jrc::Point<int16_t>(-1600, -1400));
+}
diff --git a/web/game-viewport.js b/web/game-viewport.js
new file mode 100644
index 0000000..089cd52
--- /dev/null
+++ b/web/game-viewport.js
@@ -0,0 +1,79 @@
+(function () {
+    'use strict';
+    const BASE_WIDTH = 800;
+    const BASE_HEIGHT = 600;
+    const MAX_AXIS = 4096;
+    const canvas = document.getElementById('canvas');
+
+    function gameSize(width, height) {
+        const ratio = width / height;
+        let gameWidth = Math.max(BASE_WIDTH, BASE_HEIGHT * ratio);
+        let gameHeight = Math.max(BASE_HEIGHT, BASE_WIDTH / ratio);
+        const reduction = Math.min(1, MAX_AXIS / Math.max(gameWidth, gameHeight));
+        gameWidth *= reduction;
+        gameHeight *= reduction;
+        return { width: Math.max(1, Math.round(gameWidth)), height: Math.max(1, Math.round(gameHeight)) };
+    }
+
+    function fitCanvas() {
+        if (!canvas) return;
+        const mobile = window.MapleMobile && window.MapleMobile.enabled;
+        const viewport = mobile && window.visualViewport;
+        const viewWidth = Math.max(1, viewport ? viewport.width : window.innerWidth);
+        const viewHeight = Math.max(1, viewport ? viewport.height : window.innerHeight);
+        if (mobile) {
+            const size = gameSize(viewWidth, viewHeight);
+            // The C++ main loop applies the queued framebuffer/camera resize.
+            // Changing it directly from a DOM event can interrupt Asyncify.
+            window.MapleMobile.resize(size.width, size.height);
+            canvas.style.width = `${viewWidth}px`;
+            canvas.style.height = `${viewHeight}px`;
+            document.documentElement.style.setProperty('--mobile-width', `${viewWidth}px`);
+            document.documentElement.style.setProperty('--mobile-height', `${viewHeight}px`);
+            document.documentElement.style.setProperty('--mobile-top', `${viewport ? viewport.offsetTop : 0}px`);
+            document.documentElement.style.setProperty('--mobile-left', `${viewport ? viewport.offsetLeft : 0}px`);
+            document.documentElement.style.setProperty('--game-hud-height', `${71 * viewHeight / size.height}px`);
+            document.documentElement.style.setProperty('--game-quickslot-height', `${75 * viewHeight / size.height}px`);
+        } else {
+            const scale = Math.min(viewWidth / BASE_WIDTH, viewHeight / BASE_HEIGHT);
+            canvas.style.width = `${Math.floor(BASE_WIDTH * scale)}px`;
+            canvas.style.height = `${Math.floor(BASE_HEIGHT * scale)}px`;
+        }
+    }
+
+    function showConnectionStatus(message, label) {
+        if (window.MapleMobile) window.MapleMobile.releaseAll();
+        document.getElementById('connection-message').textContent = message;
+        const button = document.getElementById('reconnect');
+        button.textContent = label;
+        document.getElementById('connection-status').hidden = false;
+        button.focus();
+    }
+
+    window.MapleWasmUI = {
+        applyScale: fitCanvas,
+        gameSize,
+        showStopped: function (disconnected) {
+            showConnectionStatus(disconnected
+                ? 'The connection to the server closed.' : 'The game has closed.',
+                disconnected ? 'Reconnect' : 'Play again');
+        },
+        showStartupError: function () {
+            showConnectionStatus('The game could not start. Check that the server is running, then try again.',
+                'Try again');
+        }
+    };
+
+    // Initial setup happens before WASM is loaded; later resizes belong to C++.
+    canvas.width = BASE_WIDTH;
+    canvas.height = BASE_HEIGHT;
+    document.getElementById('reconnect').addEventListener('click', () => window.location.reload());
+    window.addEventListener('resize', fitCanvas);
+    document.addEventListener('fullscreenchange', fitCanvas);
+    document.addEventListener('webkitfullscreenchange', fitCanvas);
+    if (window.visualViewport) {
+        window.visualViewport.addEventListener('resize', fitCanvas);
+        window.visualViewport.addEventListener('scroll', fitCanvas);
+    }
+    fitCanvas();
+})();
