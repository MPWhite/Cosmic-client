+
+TEST_CASE("Foreign hits retain character identity and damage across v83 source variants")
+{
+    PacketFixture packet(0xC0);
+    packet.write_int(1'800'000'021);
+    int8_t source = -1;
+    SUBCASE("contact") { source = -1; }
+    SUBCASE("poison reserved field") { source = -3; }
+    SUBCASE("environment") { source = -4; }
+    SUBCASE("monster skill") { source = 1; }
+    packet.write_byte(source);
+    if (source == -3)
+        packet.write_int(0x11223344);
+    packet.write_int(37);
+    packet.write_int(100100); // Remaining metadata must not become the damage.
+    auto input = packet.input();
+    const auto hit = jrc::RemoteDamage::parse(input);
+    CHECK(hit.character_id == 1'800'000'021);
+    CHECK(hit.damage == 37);
+    CHECK(input.read_int() == 100100);
+}
+
+TEST_CASE("Foreign misses and truncated poison packets preserve safe hit parsing")
+{
+    SUBCASE("zero damage remains a miss")
+    {
+        PacketFixture packet(0xC0);
+        packet.write_int(52);
+        packet.write_byte(-1);
+        packet.write_int(0);
+        auto input = packet.input();
+        CHECK(jrc::RemoteDamage::parse(input).damage == 0);
+    }
+    SUBCASE("missing poison amount is rejected")
+    {
+        const std::array<int8_t, 10> bytes{52,0,0,0,-3,0,0,0,0,42};
+        InPacket input(bytes.data(),bytes.size());
+        CHECK_THROWS_AS(jrc::RemoteDamage::parse(input), PacketError);
+    }
+}
+
+TEST_CASE("Private resident loot cannot mask human drops or change public pickup rules")
+{
+    using jrc::DropPickupPolicy::is_private_resident_loot;
+    CHECK(is_private_resident_loot(1'800'000'021, 0));
+    CHECK(is_private_resident_loot(1'800'000'000, 0));
+    CHECK_FALSE(is_private_resident_loot(1'799'999'999, 0));
+    CHECK_FALSE(is_private_resident_loot(123, 0));
+    CHECK_FALSE(is_private_resident_loot(1'800'000'021, 1));
+    CHECK_FALSE(is_private_resident_loot(1'800'000'021, 2));
+    CHECK_FALSE(is_private_resident_loot(1'800'000'021, 3));
+}
diff --git a/src/client/Net/Handlers/Helpers/RemoteDamage.h b/src/client/Net/Handlers/Helpers/RemoteDamage.h
new file mode 100644
--- /dev/null
+++ b/src/client/Net/Handlers/Helpers/RemoteDamage.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "../../InPacket.h"
+
+namespace jrc::RemoteDamage
+{
+    struct Hit
+    {
+        int32_t character_id;
+        int32_t damage;
+    };
+
+    inline Hit parse(InPacket& recv)
+    {
+        const int32_t character_id = recv.read_int();
+        const int8_t source = recv.read_byte();
+        // v83 poison damage includes a reserved int before the amount.
+        if (source == -3)
+            recv.skip(4);
+        const int32_t damage = recv.read_int();
+        // Monster/reflection metadata follows, but hit display needs only this
+        // common prefix. Knockback remains authoritative movement from the server.
+        return {character_id, damage};
+    }
+}
diff --git a/src/client/Gameplay/MapleMap/DropPickupPolicy.h b/src/client/Gameplay/MapleMap/DropPickupPolicy.h
new file mode 100644
--- /dev/null
+++ b/src/client/Gameplay/MapleMap/DropPickupPolicy.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+
+namespace jrc::DropPickupPolicy
+{
+    constexpr bool is_private_resident_loot(int32_t owner, int8_t pickup_type)
+    {
+        // Cosmic reserves this network-id range for residents, never accounts.
+        // Public drops and ordinary player ownership retain existing behavior.
+        return owner >= 1'800'000'000 && pickup_type == 0;
+    }
+}
