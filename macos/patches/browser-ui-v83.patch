+TEST_CASE("v83 channel artwork fits the parchment without overlapping adjacent channels")
+{
+    test_support::NxFile ui("UI_83.nx", nl::nx::ui);
+    const auto source = nl::nx::ui["Login.img"]["WorldSelect"];
+    const Texture parchment(source["chBackgrn"]);
+    REQUIRE(parchment.is_valid());
+    const auto top = Point<int16_t>(400, 321) - parchment.get_origin();
+    const auto bottom = top + parchment.get_dimensions();
+    for (uint8_t i = 0; i < 20; ++i)
+    {
+        const Point<int16_t> location(200 + (i % 4) * 100, 260 + (i / 4) * 33);
+        TwoSpriteButton channel(source["channel"][i]["normal"], source["channel"][i]["normal"], location);
+        const auto bounds = channel.bounds({});
+        CHECK(bounds.l() >= top.x());
+        CHECK(bounds.t() >= top.y());
+        CHECK(bounds.r() <= bottom.x());
+        CHECK(bounds.b() <= bottom.y());
+        CHECK(channel.width() < 100);
+        CHECK(channel.height() < 33);
+        test_support::draws.clear();
+        channel.draw({});
+        REQUIRE(test_support::draws.size() == 1);
+        CHECK(test_support::draws.front().bitmap.data() != nullptr);
+    }
