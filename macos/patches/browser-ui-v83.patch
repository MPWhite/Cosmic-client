@@ -0,0 +1,79 @@
+#include <doctest/doctest.h>
+#include "client/IO/UITypes/UICharSelectPage.h"
+#include "client/IO/UITypes/UIItemInventoryLayout.h"
+
+using namespace jrc;
+
+TEST_CASE("Character pages stop at the final slot and select only visible characters")
+{
+    auto full = UICharSelectPage::resolve(8, 8, 0, 7);
+    CHECK_FALSE(full.next);
+    CHECK(full.selection == 7);
+    CHECK(full.characters == 8);
+
+    auto next = UICharSelectPage::resolve(10, 16, 1, 7);
+    CHECK(next.selection == 8);
+    CHECK(next.relative_selection == 0);
+    CHECK(next.characters == 2);
+    CHECK(next.previous);
+    CHECK_FALSE(next.next);
+
+    auto previous = UICharSelectPage::resolve(10, 16, 0, 9);
+    CHECK(previous.selection == 0);
+    CHECK(previous.characters == 8);
+    CHECK(previous.next);
+
+    auto stale_setting = UICharSelectPage::resolve(1, 3, 31, 255);
+    CHECK(stale_setting.page == 0);
+    CHECK(stale_setting.selection == 0);
+    CHECK(stale_setting.slots == 3);
+}
+
+TEST_CASE("Empty character pages never underflow counts or invent a selection")
+{
+    auto empty_account = UICharSelectPage::resolve(0, 3, 0, 0);
+    CHECK(empty_account.characters == 0);
+    CHECK(empty_account.slots == 3);
+    CHECK_FALSE(empty_account.next);
+
+    auto no_slots = UICharSelectPage::resolve(0, 0, 255, 255);
+    CHECK(no_slots.page == 0);
+    CHECK(no_slots.characters == 0);
+    CHECK(no_slots.slots == 0);
+
+    auto deleted_last = UICharSelectPage::resolve(8, 16, 1, 8);
+    CHECK(deleted_last.characters == 0);
+    CHECK(deleted_last.slots == 8);
+    CHECK(deleted_last.relative_selection == 0);
+}
+
+TEST_CASE("Inventory cells hit the item drawn there on every visible row")
+{
+    for (const bool legacy : {true, false})
+    {
+        const UIItemInventoryLayout layout(legacy);
+        for (const int16_t first : {1, 73})
+            for (int16_t slot = first; slot < first + 24; ++slot)
+            {
+                const auto top = layout.slot_position(slot, first);
+                CHECK(layout.slot_at(top, first, 96) == slot);
+                CHECK(layout.slot_at(top + Point<int16_t>(31, 31), first, 96) == slot);
+                CHECK(layout.slot_at(top + Point<int16_t>(32, 0), first, 96) == 0);
+                CHECK(layout.slot_at(top + Point<int16_t>(0, 32), first, 96) == 0);
+            }
+        CHECK(layout.slot_at(layout.origin - Point<int16_t>(1, 0), 1, 96) == 0);
+        CHECK(layout.slot_at(layout.origin + Point<int16_t>(144, 0), 1, 96) == 0);
+        CHECK(layout.slot_at(layout.origin + Point<int16_t>(0, layout.row_height * 6), 1, 96) == 0);
+    }
+}
+
+TEST_CASE("Inventory capacity includes its last slot without scrolling an extra row")
+{
+    const UIItemInventoryLayout layout(true);
+    CHECK(UIItemInventoryLayout::row_count(24) == 6);
+    CHECK(UIItemInventoryLayout::row_count(25) == 7);
+    CHECK(UIItemInventoryLayout::row_count(96) == 24);
+    CHECK(layout.slot_at(layout.slot_position(96, 73), 73, 96) == 96);
+    CHECK(layout.slot_at(layout.slot_position(25, 5), 5, 25) == 25);
+    CHECK(layout.slot_at(layout.slot_position(26, 5), 5, 25) == 0);
+}
