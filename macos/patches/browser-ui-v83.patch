@@ -0,0 +1,12 @@
+#pragma once
+
+#include "nlnx/node.hpp"
+
+namespace jrc
+{
+    inline nl::node npc_service_assets(nl::node ui, const char* name)
+    {
+        const auto classic = ui["UIWindow.img"][name];
+        return classic["backgrnd"] ? classic : ui["UIWindow2.img"][name];
+    }
+}
