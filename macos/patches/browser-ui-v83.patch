+        const auto bounds = button.bounds({});
+        CHECK(bounds.t() >= 94);
+        CHECK(bounds.r() <= frame.width());
+        CHECK(bounds.b() < 235);
+    }
+    MapleButton back(source["BtDel"], {90, 199});
+    CHECK(back.bounds({}).t() >= 199);
+    CHECK(back.bounds({}).r() <= frame.width());
+    CHECK(back.bounds({}).b() < 235);
+    for (const auto name : {"BtOK", "BtCancel"})
