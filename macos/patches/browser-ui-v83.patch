diff --git a/src/client/Net/Handlers/Helpers/NpcDialogue.h b/src/client/Net/Handlers/Helpers/NpcDialogue.h
new file mode 100644
index 0000000..e74df0a
--- /dev/null
+++ b/src/client/Net/Handlers/Helpers/NpcDialogue.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include "../../InPacket.h"
+#include <charconv>
+#include <optional>
+
+namespace jrc
+{
+    // Cosmic v83 PacketCreator.getNPCTalk* payloads, after the opcode.
+    struct NpcDialogue
+    {
+        int32_t npcid = 0;
+        int8_t type = 0;
+        int8_t speaker = 0;
+        std::string text;
+        int16_t navigation = 0;
+        bool has_navigation = false;
+        std::string initial_text;
+        int32_t minimum = 0;
+        int32_t maximum = 0;
+        bool supported = true;
+
+        static NpcDialogue read(InPacket& packet)
+        {
+            NpcDialogue result;
+            packet.skip(1);
+            result.npcid = packet.read_int();
+            result.type = packet.read_byte();
+            result.speaker = packet.read_byte();
+            // Quizzes and appearance pickers use different payloads. Do not
+            // mistake those bytes for a string or send an invalid OK reply.
+            switch (result.type)
+            {
+            case 0: case 1: case 2: case 3: case 4: case 12:
+                break;
+            default:
+                result.supported = false;
+                result.text = "This conversation needs a dialog that is not available yet. Please close this window to continue.";
+                return result;
+            }
+            result.text = packet.read_string();
+            switch (result.type)
+            {
+            case 0:
+                result.navigation = packet.read_short();
+                result.has_navigation = true;
+                break;
+            case 2:
+                result.initial_text = packet.read_string();
+                packet.skip(4);
+                break;
+            case 3:
+                result.initial_text = std::to_string(packet.read_int());
+                result.minimum = packet.read_int();
+                result.maximum = packet.read_int();
+                packet.skip(4);
+                break;
+            default:
+                break;
+            }
+            return result;
+        }
+
+        static std::optional<int32_t> number(const std::string& input, int32_t minimum, int32_t maximum)
+        {
+            int32_t value;
+            const auto parsed = std::from_chars(input.data(), input.data() + input.size(), value);
+            if (parsed.ec != std::errc() || parsed.ptr != input.data() + input.size() ||
+                value < minimum || value > maximum)
+                return {};
+            return value;
+        }
+    };
+}
