+TEST_CASE("Notices and quantity prompts render visible controls and honor cancellation")
+{
+    test_support::NxFile ui("UI.nx", nl::nx::ui);
+    Constants::set_viewsize(800, 600);
+    int answer = -1;
+    Notice<UIYesNo> confirmation("Buy this item?", [&](bool yes) { answer = yes; });
+    confirmation.verify_frame();
+    confirmation.click(1);
+    CHECK(answer == 0);
+    CHECK_FALSE(confirmation.is_active());
+    int callbacks = 0;
+    Notice<UIOk> message("Thank you!", [&] { ++callbacks; });
+    message.verify_frame();
+    message.click(0);
+    CHECK(callbacks == 1);
+    int quantity = 0;
+    Notice<UIEnterNumber> number("How many would you like?", [&](int32_t value) { quantity = value; }, 1, 100, 1);
+    number.verify_frame();
+    REQUIRE(focused != nullptr);
+    auto* field = focused;
+    field->change_text("101");
+    number.click(0);
+    CHECK(number.is_active());
+    CHECK(quantity == 0);
+    field->change_text("5abc");
+    number.click(0);
+    CHECK(number.is_active());
+    CHECK(quantity == 0);
+    field->change_text("5");
+    number.click(0);
+    CHECK(quantity == 5);
+    CHECK_FALSE(number.is_active());
+    CHECK(focused == nullptr);
+    test_support::snapshot(test_support::artifact("classic-quantity-prompt.ppm"), number.size().x(), number.size().y());
+}
