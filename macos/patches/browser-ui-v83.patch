+
+namespace
+{
+    using namespace jrc;
+    using test_support::draws;
+    Textfield* focused = nullptr;
+    uint64_t press_id = 0;
+    std::vector<std::string> rendered_text;
+    class NoticeState : public UIStateNull
+    {
+    public:
+        Iterator pre_add(UIElement::Type type, bool, bool) override { return elements.find(type); }
+        UIElement* get(UIElement::Type type) override { return elements[type].get(); }
+    private:
+        EnumMap<UIElement::Type, std::unique_ptr<UIElement>, UIElement::NUM_TYPES> elements;
+    };
+    template<class T> class Notice : public T
+    {
+    public:
+        template<class... Args> explicit Notice(Args&&... args) : T(std::forward<Args>(args)...)
+        {
+            this->set_type(UIElement::NOTICE);
+            this->restore_position({});
+            this->update();
+        }
+        Point<int16_t> size() const { return this->dimension; }
+        void click(size_t id)
+        {
+            const auto bounds = this->buttons.at(id)->bounds({});
+            const Point<int16_t> point((bounds.l() + bounds.r()) / 2, (bounds.t() + bounds.b()) / 2);
+            ++press_id;
+            this->send_cursor(true, point);
+            this->send_cursor(false, point);
+        }
+        void verify_frame()
+        {
+            REQUIRE(this->dimension.x() > 200);
+            REQUIRE(this->dimension.y() > 80);
+            draws.clear();
+            this->draw_checked(1.0f);
+            REQUIRE(draws.size() >= 4);
+            for (const auto& draw : draws)
+            {
+                CHECK(draw.bounds.l() >= 0);
+                CHECK(draw.bounds.t() >= 0);
+                CHECK(draw.bounds.r() <= this->dimension.x());
+                CHECK(draw.bounds.b() <= this->dimension.y());
+            }
+            for (const auto& button : this->buttons)
+            {
+                CHECK(button.second->width() > 0);
+                CHECK(button.second->height() > 0);
+            }
+        }
+    };
+}
+
+namespace jrc
+{
+    // Capture drawing and text focus while exercising the production frame,
+    // field, buttons, hit testing and numeric validation with the real v83 art.
+    GraphicsGL::GraphicsGL() : locked(false) {}
+    void GraphicsGL::addbitmap(const nl::bitmap&) {}
+    void GraphicsGL::draw(const nl::bitmap& bitmap, const Rectangle<int16_t>& rect, const Color&, float)
+    { draws.push_back({bitmap, rect}); }
+    void GraphicsGL::draw_clipped(const nl::bitmap&, const Rectangle<int16_t>&, const Color&, Range<int16_t>) {}
+    Text::Layout GraphicsGL::createlayout(const std::string& text, Text::Font, Text::Alignment, int16_t maxwidth, bool)
+    {
+        const int16_t width = static_cast<int16_t>(text.size() * 6);
+        std::vector<int16_t> advances(text.size() + 1);
+        for (size_t i = 0; i < advances.size(); ++i) advances[i] = i * 6;
+        return {{}, advances, static_cast<int16_t>(maxwidth ? std::min(width, maxwidth) : width),
+            static_cast<int16_t>(text.empty() ? 0 : 16), width, 0};
+    }
+    void GraphicsGL::drawtext(const DrawArgument&, const std::string& text, const Text::Layout&,
+        Text::Font, Text::Color, Text::Background, const Range<int16_t>*) { rendered_text.push_back(text); }
+    UI::UI() : cursor_press_id(0), enabled(true), quitted(false) { state = std::make_unique<NoticeState>(); }
+    void UI::set_scrollnotice(const std::string&) {}
+    void UIStatusbar::send_chatline(const std::string&, UIChatbar::LineType) {}
+    uint64_t UI::get_cursor_press_id() const { return press_id; }
+    void UI::focus_textfield(Textfield* field) { focused = field; }
+    void UI::blur_textfield(Textfield* field) { if (focused == field) focused = nullptr; }
+    void UI::remove_textfield() { focused = nullptr; }
+    Keyboard::Keyboard() {}
+    Cursor::Cursor() : state(IDLE), hide_counter(0) {}
+    ScrollingNotice::ScrollingNotice() : active(false) {}
+    ColorBox::ColorBox() : width(0), height(0), color(Geometry::BLACK), opacity(0) {}
+    Sound::Sound(Name) : id(0) {}
+    void Sound::play() const {}
+}
