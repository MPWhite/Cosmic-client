diff --git a/src/client/IO/UITypes/UIItemInventoryLayout.h b/src/client/IO/UITypes/UIItemInventoryLayout.h
new file mode 100644
index 0000000..3b05a8a
--- /dev/null
+++ b/src/client/IO/UITypes/UIItemInventoryLayout.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "../../Template/Point.h"
+#include <cstdint>
+
+namespace jrc
+{
+    struct UIItemInventoryLayout
+    {
+        Point<int16_t> origin;
+        int16_t row_height;
+        static constexpr int16_t columns = 4;
+        static constexpr int16_t rows = 6;
+
+        explicit UIItemInventoryLayout(bool legacy)
+            : origin(legacy ? Point<int16_t>(8, 50) : Point<int16_t>(11, 51)),
+              row_height(legacy ? 34 : 35) {}
+
+        static int16_t row_count(int16_t slots) { return (slots + columns - 1) / columns; }
+
+        Point<int16_t> slot_position(int16_t slot, int16_t first) const
+        {
+            const int16_t offset = slot - first;
+            return origin + Point<int16_t>((offset % columns) * 36, (offset / columns) * row_height);
+        }
+
+        int16_t slot_at(Point<int16_t> cursor, int16_t first, int16_t slot_count) const
+        {
+            const auto offset = cursor - origin;
+            if (offset.x() < 0 || offset.x() >= columns * 36 ||
+                offset.y() < 0 || offset.y() >= rows * row_height ||
+                offset.x() % 36 >= 32 || offset.y() % row_height >= 32)
+                return 0;
+            const int16_t slot = first + offset.x() / 36 + columns * (offset.y() / row_height);
+            return slot <= slot_count ? slot : 0;
+        }
+    };
+}
