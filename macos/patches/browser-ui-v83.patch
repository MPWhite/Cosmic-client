+TEST_CASE("Server popup rejection packets display their reason instead of disappearing")
+{
+    test_support::NxFile ui("UI.nx", nl::nx::ui);
+    Constants::set_viewsize(800, 600);
+    const std::string reason = "You may only use the storage once you have reached level 15.";
+    test_support::PacketFixture packet(0x44);
+    packet.write_byte(1);
+    packet.write_string(reason);
+    auto input = packet.input();
+    jrc::ServerMessageHandler handler;
+    static_cast<const jrc::PacketHandler&>(handler).handle(input);
+    CHECK_FALSE(input.available());
+    auto popup = UI::get().get_element<UIOk>();
+    REQUIRE(popup);
+    REQUIRE(popup->is_active());
+    rendered_text.clear();
+    popup->draw(1.0f);
+    CHECK(std::find(rendered_text.begin(), rendered_text.end(), reason) != rendered_text.end());
+    popup->send_key(KeyAction::RETURN, true, false);
+    CHECK_FALSE(popup->is_active());
+}
