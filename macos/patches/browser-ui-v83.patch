diff --git a/src/client/IO/UITypes/UICharSelectPage.h b/src/client/IO/UITypes/UICharSelectPage.h
new file mode 100644
index 0000000..8860b55
--- /dev/null
+++ b/src/client/IO/UITypes/UICharSelectPage.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace jrc
+{
+    // A page may contain vacant character slots, including an entirely empty
+    // page. Its selection must never refer to a character on another page.
+    struct UICharSelectPage
+    {
+        uint8_t page;
+        uint8_t characters;
+        uint8_t slots;
+        uint8_t selection;
+        uint8_t relative_selection;
+        bool previous;
+        bool next;
+
+        static UICharSelectPage resolve(uint8_t character_count, uint8_t slot_count,
+            uint8_t requested_page, uint8_t selected, uint8_t page_size = 8)
+        {
+            slot_count = std::max(slot_count, character_count);
+            const uint8_t last_page = slot_count ? (slot_count - 1) / page_size : 0;
+            const uint8_t page = std::min(requested_page, last_page);
+            const unsigned first = page * page_size;
+            const uint8_t count = first < character_count ?
+                std::min<unsigned>(page_size, character_count - first) : 0;
+            const uint8_t slots = first < slot_count ?
+                std::min<unsigned>(page_size, slot_count - first) : 0;
+            if (selected < first || selected >= first + count)
+                selected = first;
+            return {page, count, slots, selected, static_cast<uint8_t>(selected - first),
+                page > 0, page < last_page};
+        }
+    };
+}
