diff --git a/src/client/IO/Components/NpcDialogAssets.h b/src/client/IO/Components/NpcDialogAssets.h
new file mode 100644
index 0000000..641b08a
--- /dev/null
+++ b/src/client/IO/Components/NpcDialogAssets.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include "nlnx/node.hpp"
+
+namespace jrc
+{
+    inline nl::node npc_dialog_assets(nl::node ui)
+    {
+        // The v83 dialog lives in UIWindow.img. Later clients moved it to
+        // UIWindow2.img; checking the real frame avoids invisible controls.
+        const auto classic = ui["UIWindow.img"]["UtilDlgEx"];
+        return classic["t"] && classic["c"] && classic["s"]
+            ? classic : ui["UIWindow2.img"]["UtilDlgEx"];
+    }
+}
