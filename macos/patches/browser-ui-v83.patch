+TEST_CASE("NPC body hit boxes follow sprite origins, flipping and camera movement")
+{
+    test_support::NxFile npc_file("Npc.nx", nl::nx::npc);
+    test_support::NxFile strings("String.nx", nl::nx::string);
+    for (int32_t id : {2000, 10000, 1012000})
+    {
+        for (bool mirrored : {false, true})
+        {
+            jrc::Npc npc(id, 42, mirrored, 0, false, {400, 350});
+            const jrc::Point<int16_t> camera(-170, 43);
+            sprites.clear();
+            npc.draw(camera.x(), camera.y(), 1.0f);
+            REQUIRE(sprites.size() == 1);
+            const auto& bounds = sprites.front().bounds;
+            const int16_t left = std::min(bounds.l(), bounds.r());
+            const int16_t right = std::max(bounds.l(), bounds.r());
+            const int16_t middle = (bounds.t() + bounds.b()) / 2;
+            CHECK(npc.inrange({static_cast<int16_t>(left + 1), middle}, camera));
+            CHECK(npc.inrange({static_cast<int16_t>(right - 1), middle}, camera));
+            CHECK_FALSE(npc.inrange({static_cast<int16_t>(left - 2), middle}, camera));
+            CHECK_FALSE(npc.inrange({static_cast<int16_t>(right + 2), middle}, camera));
+            CHECK(npc.inrange(jrc::Point<int16_t>(400, 358) + camera, camera));
+            CHECK_FALSE(npc.inrange(jrc::Point<int16_t>(600, 358) + camera, camera));
+        }
+    }
+}
