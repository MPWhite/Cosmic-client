diff --git a/src/client/Net/Handlers/ServerMessageHandler.cpp b/src/client/Net/Handlers/ServerMessageHandler.cpp
new file mode 100644
index 0000000..25415bc
--- /dev/null
+++ b/src/client/Net/Handlers/ServerMessageHandler.cpp
@@ -0,0 +1,59 @@
+#include "MessagingHandlers.h"
+
+#include "../../IO/UI.h"
+#include "../../IO/UITypes/UINotice.h"
+#include "../../IO/UITypes/UIStatusBar.h"
+
+namespace jrc
+{
+    void ServerMessageHandler::handle(InPacket& recv) const
+    {
+        int8_t type = recv.read_byte();
+        bool servermessage = type == 4 && recv.available() && recv.inspect_bool();
+        if (servermessage)
+            recv.skip(1);
+
+        if (recv.length() < sizeof(uint16_t) ||
+            recv.length() < sizeof(uint16_t) + static_cast<uint16_t>(recv.inspect_short()))
+        {
+            return;
+        }
+
+        std::string message = recv.read_string();
+
+        if (type == 1)
+        {
+            // Cosmic uses popup notices for rejected actions, including the
+            // storage level requirement. Dropping these makes NPCs look inert.
+            UI::get().emplace<UIOk>(message, [] {});
+        }
+        else if (type == 3)
+        {
+            recv.read_byte(); // channel
+            recv.read_bool(); // megaphone
+        }
+        else if (type == 4)
+        {
+            UI::get().set_scrollnotice(message);
+        }
+        else if (type == 5)
+        {
+            if (auto statusbar = UI::get().get_element<UIStatusbar>())
+                statusbar->send_chatline(message, UIChatbar::WHITE);
+        }
+        else if (type == 6)
+        {
+            if (recv.length() >= sizeof(int32_t))
+            {
+                recv.read_int(); // unknown field, always 0 in Cosmic
+            }
+
+            if (auto statusbar = UI::get().get_element<UIStatusbar>())
+                statusbar->send_chatline(message, UIChatbar::WHITE);
+        }
+        else if (type == 7)
+        {
+            recv.read_int(); // npcid
+        }
+    }
+}
