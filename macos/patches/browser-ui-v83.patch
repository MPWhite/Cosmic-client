+#include "support/packet_fixture.h"
+#include "client/Net/Handlers/Helpers/NpcDialogue.h"
+#include "client/Net/Packets/NpcInteractionPackets.h"
+
+using jrc::NpcDialogue;
+using jrc::NpcTalkMorePacket;
+using test_support::PacketFixture;
+
+namespace
+{
+    PacketFixture dialogue(int8_t type, const std::string& text)
+    {
+        PacketFixture packet;
+        packet.write_byte(4);
+        packet.write_int(9000000);
+        packet.write_byte(type);
+        packet.write_byte(0);
+        packet.write_string(text);
+        return packet;
+    }
+}
+
+TEST_CASE("Cosmic v83 NPC pages distinguish navigation from yes-no prompts")
+{
+    auto page = dialogue(0, "Continue");
+    page.write_byte(1);
+    page.write_byte(1);
+    auto input = page.input();
+    const auto parsed = NpcDialogue::read(input);
+    CHECK(parsed.npcid == 9000000);
+    CHECK(parsed.text == "Continue");
+    CHECK(parsed.has_navigation);
+    CHECK(parsed.navigation == 0x0101);
+    CHECK_FALSE(input.available());
+
+    for (int8_t type : {1, 4, 12})
+    {
+        auto prompt = dialogue(type, "Choose");
+        auto bytes = prompt.input();
+        const auto choice = NpcDialogue::read(bytes);
+        CHECK(choice.type == type);
+        CHECK_FALSE(choice.has_navigation);
+        CHECK_FALSE(bytes.available());
+    }
+}
+
+TEST_CASE("Cosmic text and number prompts preserve defaults and limits")
+{
+    auto text = dialogue(2, "Your name?");
+    text.write_string("Mapler");
+    text.write_int(0);
+    auto text_input = text.input();
+    CHECK(NpcDialogue::read(text_input).initial_text == "Mapler");
+    CHECK_FALSE(text_input.available());
+
+    auto number = dialogue(3, "How many?");
+    number.write_int(5);
+    number.write_int(1);
+    number.write_int(100);
+    number.write_int(0);
+    auto number_input = number.input();
+    const auto parsed = NpcDialogue::read(number_input);
+    CHECK(parsed.initial_text == "5");
+    CHECK(parsed.minimum == 1);
+    CHECK(parsed.maximum == 100);
+    CHECK_FALSE(number_input.available());
+    CHECK(NpcDialogue::number("100", 1, 100) == 100);
+    for (const char* invalid : {"", "0", "101", "1.5", "5abc", "999999999999999999"})
+        CHECK_FALSE(NpcDialogue::number(invalid, 1, 100).has_value());
+    CHECK(NpcDialogue::number("-2147483648", INT32_MIN, 0) == INT32_MIN);
+}
+
+TEST_CASE("NPC replies encode selection values and safe text-entry cancellation")
+{
+    test_support::expect_packet(jrc::TalkToNPCPacket(0x12345678), {0x3a, 0, 0x78, 0x56, 0x34, 0x12});
+    test_support::expect_packet(NpcTalkMorePacket(0, 1), {0x3c, 0, 0, 1});
+    test_support::expect_packet(NpcTalkMorePacket(0, 0), {0x3c, 0, 0, 0});
+    test_support::expect_packet(NpcTalkMorePacket::selection(4, 500), {0x3c, 0, 4, 1, 0xf4, 1, 0, 0});
+    test_support::expect_packet(NpcTalkMorePacket::selection(3, 10), {0x3c, 0, 3, 1, 10, 0, 0, 0});
+    test_support::expect_packet(NpcTalkMorePacket(std::string("Hi")), {0x3c, 0, 2, 1, 2, 0, 'H', 'i'});
+    test_support::expect_packet(NpcTalkMorePacket::close(2), {0x3c, 0, 2, 0});
+    test_support::expect_packet(NpcTalkMorePacket::close(0), {0x3c, 0, 0, 0xff});
+    test_support::expect_packet(NpcTalkMorePacket::close(12), {0x3c, 0, 12, 0xff});
+}
+
+TEST_CASE("Unsupported and truncated NPC payloads do not masquerade as normal pages")
+{
+    auto style = dialogue(7, "Style");
+    auto style_input = style.input();
+    CHECK_FALSE(NpcDialogue::read(style_input).supported);
+    auto truncated = dialogue(3, "How many?");
+    truncated.write_int(1);
+    auto input = truncated.input();
+    CHECK_THROWS_AS(NpcDialogue::read(input), jrc::PacketError);
+}
