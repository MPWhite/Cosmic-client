new file mode 100644
index 0000000..fe46c8d
--- /dev/null
+++ b/tests/test_mobile_controls.py
@@ -0,0 +1,121 @@
+"""Browser-only input regressions; requires Playwright and Google Chrome.
+
+    python tests/test_mobile_controls.py
+
+These tests use a mock WASM bridge, so no game account or server is needed.
+"""
+from pathlib import Path
+import unittest
+
+from playwright.sync_api import sync_playwright
+
+
+WEB = Path(__file__).resolve().parents[1] / "web"
+
+
+class MobileControlsTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.playwright = sync_playwright().start()
+        cls.browser = cls.playwright.chromium.launch(channel="chrome")
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.browser.close()
+        cls.playwright.stop()
+
+    def setUp(self):
+        self.context = self.browser.new_context(
+            viewport={"width": 844, "height": 390}, is_mobile=True, has_touch=True
+        )
+        self.page = self.context.new_page()
+        self.errors = []
+        self.page.on("pageerror", lambda error: self.errors.append(str(error)))
+        self.load(self.page)
+
+    def tearDown(self):
+        self.context.close()
+        self.assertEqual(self.errors, [])
+
+    def load(self, page):
+        page.set_content('<meta name="viewport" content="width=device-width, initial-scale=1"><canvas id="canvas"></canvas>')
+        page.add_style_tag(path=str(WEB / "mobile-controls.css"))
+        page.evaluate("""() => {
+            window.calls = [];
+            window.Module = {ccall: (name, result, types, args) => calls.push([name, ...args])};
+        }""")
+        page.add_script_tag(path=str(WEB / "mobile-controls.js"))
+        page.evaluate("MapleMobile.ready(); MapleMobile.setGameState(1)")
+
+    def calls(self):
+        return self.page.evaluate("calls")
+
+    def center(self, selector):
+        box = self.page.locator(selector).bounding_box()
+        return {"x": box["x"] + box["width"] / 2, "y": box["y"] + box["height"] / 2}
+
+    def test_multitouch_actions_release_on_cancel(self):
+        session = self.context.new_cdp_session(self.page)
+        right = dict(self.center('[data-action="61"]'), id=1)
+        jump = dict(self.center('[data-action="53"]'), id=2)
+        session.send("Input.dispatchTouchEvent", {"type": "touchStart", "touchPoints": [right]})
+        session.send("Input.dispatchTouchEvent", {"type": "touchStart", "touchPoints": [right, jump]})
+        session.send("Input.dispatchTouchEvent", {"type": "touchCancel", "touchPoints": []})
+        self.assertEqual(self.calls(), [
+            ["maple_mobile_action", 61, 1], ["maple_mobile_action", 53, 1],
+            ["maple_mobile_action", 61, 0], ["maple_mobile_action", 53, 0],
+        ])
+        self.assertEqual(self.page.locator(".held").count(), 0)
+
+    def test_blur_and_state_change_release_actions(self):
+        point = self.center('[data-action="60"]')
+        self.page.mouse.move(**point)
+        self.page.mouse.down()
+        self.page.evaluate("window.dispatchEvent(new Event('blur'))")
+        self.page.mouse.up()
+        self.assertEqual(self.calls(), [["maple_mobile_action", 60, 1], ["maple_mobile_action", 60, 0]])
+        self.page.mouse.down()
+        self.page.evaluate("MapleMobile.setGameState(0)")
+        self.page.mouse.up()
+        self.assertEqual(self.calls()[-2:], [["maple_mobile_action", 60, 1], ["maple_mobile_action", 60, 0]])
+
+    def test_native_text_masks_secret_and_isolates_keyboard(self):
+        self.page.evaluate("""() => {
+            MapleMobile.setGameState(0);
+            MapleMobile.setFocusedField(17, '', true, 12);
+            window.gameKeys = [];
+            window.addEventListener('keydown', event => gameKeys.push(event.key), true);
+        }""")
+        field = self.page.locator("#mobile-input")
+        self.assertEqual(field.get_attribute("type"), "password")
+        field.fill("example")
+        field.press("Backspace")
+        field.press("Tab")
+        self.assertEqual(self.page.evaluate("gameKeys"), [])
+        self.assertEqual(self.calls(), [
+            ["maple_mobile_text", 17, "example"],
+            ["maple_mobile_text", 17, "exampl"],
+            ["maple_mobile_command", 1],
+        ])
+        self.page.evaluate("MapleMobile.setFocusedField(18, 'new', false, 20)")
+        self.assertEqual(field.input_value(), "new")
+        self.assertEqual(field.get_attribute("type"), "text")
+        self.page.evaluate("MapleMobile.setFocusedField(0, '', false, 0)")
+        self.assertEqual(field.input_value(), "")
+        self.assertFalse(self.page.locator("#mobile-editor").is_visible())
+
+    def test_desktop_unchanged(self):
+        context = self.browser.new_context(viewport={"width": 1200, "height": 800})
+        try:
+            page = context.new_page()
+            self.load(page)
+            page.evaluate("MapleMobile.setFocusedField(7, 'example', true, 12)")
+            self.assertFalse(page.locator("#mobile-ui").is_visible())
+            self.assertEqual(page.locator("#mobile-input").input_value(), "")
+            self.assertFalse(page.evaluate("document.body.classList.contains('mobile-game')"))
+        finally:
+            context.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
