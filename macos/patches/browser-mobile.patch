--- /dev/null
+++ b/web/mobile-controls.css
@@ -0,0 +1,60 @@
+#mobile-ui { display: none; }
+body.mobile-game { touch-action: none; height: var(--mobile-height, 100dvh); }
+body.mobile-game #canvas { touch-action: none; }
+body.mobile-game #mobile-ui {
+    display: block; position: fixed; inset: 0; height: var(--mobile-height, 100dvh);
+    z-index: 5; pointer-events: none; user-select: none; -webkit-user-select: none;
+    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
+    box-sizing: border-box; font-size: 12px;
+}
+#mobile-ui button {
+    pointer-events: auto; touch-action: none; border: 1px solid #ffffff80;
+    border-radius: 12px; color: white; background: #152a42bd; font: 600 12px system-ui;
+    min-height: 40px; padding: 7px 10px; -webkit-tap-highlight-color: transparent;
+    box-shadow: 0 2px 5px #0008;
+}
+#mobile-ui button:active, #mobile-ui button.held { background: #c27f1ce6; }
+#mobile-ui button:disabled { opacity: .4; }
+#mobile-toolbar {
+    position: absolute; top: max(5px, env(safe-area-inset-top)); left: max(5px, env(safe-area-inset-left));
+    right: max(5px, env(safe-area-inset-right)); display: flex; gap: 5px; flex-wrap: wrap;
+}
+#mobile-toolbar button { min-height: 34px; padding: 5px 9px; }
+#mobile-toolbar .mobile-game-only { display: none; }
+#mobile-ui.in-game #mobile-toolbar .mobile-game-only { display: block; }
+#mobile-keyboard { margin-left: auto; }
+#mobile-dpad, #mobile-actions { display: none; position: absolute; bottom: max(12px, env(safe-area-inset-bottom)); gap: 5px; }
+#mobile-ui.in-game #mobile-dpad, #mobile-ui.in-game #mobile-actions { display: grid; }
+#mobile-dpad { left: max(8px, env(safe-area-inset-left)); grid-template-columns: repeat(3, 46px); grid-template-rows: repeat(3, 46px); }
+#mobile-dpad button { font-size: 23px; padding: 0; }
+#mobile-dpad [data-action="62"] { grid-column: 2; }
+#mobile-dpad [data-action="60"] { grid-column: 1; grid-row: 2; }
+#mobile-dpad [data-action="61"] { grid-column: 3; grid-row: 2; }
+#mobile-dpad [data-action="63"] { grid-column: 2; grid-row: 3; }
+#mobile-actions { right: max(8px, env(safe-area-inset-right)); grid-template-columns: repeat(2, 57px); grid-template-rows: repeat(2, 55px); }
+#mobile-actions [data-action="52"] { background: #a64b21cc; }
+#mobile-actions [data-action="53"] { background: #236e9dcc; }
+#mobile-rotate {
+    display: none; position: absolute; top: 54px; left: 15px; right: 15px;
+    text-align: center; padding: 9px; border-radius: 8px; background: #152a42e6;
+}
+#mobile-editor {
+    pointer-events: auto; position: absolute; bottom: max(6px, env(safe-area-inset-bottom));
+    left: max(8px, env(safe-area-inset-left)); right: max(8px, env(safe-area-inset-right));
+    display: flex; align-items: center; gap: 6px; padding: 7px; border-radius: 10px;
+    background: #152a42f5; box-shadow: 0 3px 12px #0009;
+}
+#mobile-editor[hidden] { display: none; }
+#mobile-input {
+    min-width: 0; flex: 1; box-sizing: border-box; height: 40px; padding: 6px 10px;
+    border: 1px solid #adc5d5; border-radius: 5px; font: 16px system-ui;
+    color: #152a42; background: #fff; user-select: text; -webkit-user-select: text; touch-action: auto;
+}
+#mobile-ui.editing #mobile-dpad, #mobile-ui.editing #mobile-actions { display: none; }
+#mobile-ui.editing #mobile-rotate { display: none; }
+@media (orientation: portrait) {
+    #mobile-rotate { display: block; }
+    #mobile-toolbar button { padding: 5px 7px; }
+    #mobile-editor { flex-wrap: wrap; }
+    #mobile-input { flex-basis: 100%; }
+}
