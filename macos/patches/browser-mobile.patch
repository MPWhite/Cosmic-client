new file mode 100644
index 0000000..9608461
--- /dev/null
+++ b/web/mobile-controls.js
@@ -0,0 +1,197 @@
+(function () {
+    'use strict';
+    const enabled = window.matchMedia('(pointer: coarse)').matches;
+    let ready = false;
+    let gameState = 0;
+    let fieldToken = 0;
+    let editing = false;
+    const pointers = new Map();
+    const counts = new Map();
+    const ui = document.createElement('div');
+    ui.id = 'mobile-ui';
+    ui.innerHTML = `
+        <div id="mobile-toolbar">
+            <button type="button" data-command="2" aria-label="Close dialog or open menu">Back</button>
+            <button type="button" class="mobile-game-only" data-command="3">Items</button>
+            <button type="button" class="mobile-game-only" data-command="4">Skills</button>
+            <button type="button" class="mobile-game-only" data-command="6">Quests</button>
+            <button type="button" class="mobile-game-only" data-command="7">Chat</button>
+            <button type="button" id="mobile-keyboard" disabled>Keyboard</button>
+        </div>
+        <div id="mobile-rotate">Rotate your phone to landscape for larger controls. Tap game buttons and NPCs directly.</div>
+        <div id="mobile-dpad" aria-label="Movement">
+            <button type="button" data-action="62" aria-label="Up / enter portal">▲</button>
+            <button type="button" data-action="60" aria-label="Move left">◀</button>
+            <button type="button" data-action="61" aria-label="Move right">▶</button>
+            <button type="button" data-action="63" aria-label="Down">▼</button>
+        </div>
+        <div id="mobile-actions" aria-label="Actions">
+            <button type="button" data-action="54">Talk</button>
+            <button type="button" data-action="50">Loot</button>
+            <button type="button" data-action="52">Attack</button>
+            <button type="button" data-action="53">Jump</button>
+        </div>
+        <form id="mobile-editor" hidden autocomplete="off">
+            <input id="mobile-input" aria-label="Selected game text field" placeholder="Tap here to type" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="done">
+            <button type="button" id="mobile-next">Next</button>
+            <button type="submit">Done</button>
+            <button type="button" id="mobile-hide" aria-label="Hide keyboard">Hide</button>
+        </form>`;
+    document.body.appendChild(ui);
+    const input = document.getElementById('mobile-input');
+    const editor = document.getElementById('mobile-editor');
+    const keyboard = document.getElementById('mobile-keyboard');
+
+    function call(name, types, args) {
+        if (!enabled || !ready || typeof Module === 'undefined' || typeof Module.ccall !== 'function') return;
+        Module.ccall(name, null, types, args);
+    }
+    function action(id, down) {
+        call('maple_mobile_action', ['number', 'number'], [id, down ? 1 : 0]);
+    }
+    function releasePointer(pointerId) {
+        const button = pointers.get(pointerId);
+        if (!button) return;
+        pointers.delete(pointerId);
+        const id = Number(button.dataset.action);
+        const count = (counts.get(id) || 1) - 1;
+        counts.set(id, count);
+        if (!count) {
+            button.classList.remove('held');
+            action(id, false);
+        }
+    }
+    function releaseAll() {
+        for (const pointerId of Array.from(pointers.keys())) releasePointer(pointerId);
+    }
+    function command(id) {
+        releaseAll();
+        call('maple_mobile_command', ['number'], [id]);
+    }
+    function setEditing(value) {
+        editing = value && !!fieldToken;
+        ui.classList.toggle('editing', editing);
+        editor.hidden = !editing;
+        if (!editing) input.blur();
+    }
+    function openKeyboard() {
+        if (!fieldToken || !ready) return;
+        releaseAll();
+        setEditing(true);
+        // The focus call stays inside the tap event for iOS's keyboard policy.
+        input.focus({ preventScroll: true });
+    }
+    function updateViewport() {
+        if (!enabled) return;
+        const viewport = window.visualViewport;
+        const height = viewport ? viewport.height : window.innerHeight;
+        document.documentElement.style.setProperty('--mobile-height', `${Math.floor(height)}px`);
+        if (window.MapleWasmUI) window.MapleWasmUI.applyScale();
+    }
+
+    window.MapleMobile = {
+        enabled,
+        ready: function () { ready = true; },
+        isEditing: function () { return enabled && editing; },
+        releaseAll,
+        setGameState: function (state) {
+            releaseAll();
+            gameState = state;
+            ui.classList.toggle('in-game', state === 1);
+        },
+        setFocusedField: function (token, value, secret, limit) {
+            if (!enabled) return;
+            const changed = token !== fieldToken;
+            fieldToken = token;
+            keyboard.disabled = !token;
+            if (!token) {
+                input.value = '';
+                setEditing(false);
+                return;
+            }
+            input.type = secret ? 'password' : 'text';
+            input.maxLength = limit > 0 ? limit : 255;
+            if (input.value !== value) input.value = value;
+            input.setAttribute('aria-label', secret ? 'Selected password or PIC field' : 'Selected game text field');
+            if (changed) {
+                releaseAll();
+                // Login gets a visible input immediately, without opening the OS
+                // keyboard until the player taps. Game dialogs use Keyboard.
+                if (gameState !== 1 || editing) setEditing(true);
+            }
+        }
+    };
+    if (!enabled) return;
+    document.body.classList.add('mobile-game');
+
+    for (const button of ui.querySelectorAll('[data-action]')) {
+        button.addEventListener('pointerdown', event => {
+            event.preventDefault();
+            if (!ready || editing) return;
+            releasePointer(event.pointerId);
+            const id = Number(button.dataset.action);
+            pointers.set(event.pointerId, button);
+            const count = counts.get(id) || 0;
+            counts.set(id, count + 1);
+            button.classList.add('held');
+            button.setPointerCapture(event.pointerId);
+            if (!count) action(id, true);
+        });
+        for (const type of ['pointerup', 'pointercancel', 'lostpointercapture'])
+            button.addEventListener(type, event => releasePointer(event.pointerId));
+        button.addEventListener('contextmenu', event => event.preventDefault());
+    }
+    for (const button of ui.querySelectorAll('[data-command]')) {
+        button.addEventListener('click', () => {
+            const id = Number(button.dataset.command);
+            if (id === 2 && editing) { setEditing(false); return; }
+            command(id);
+            if (id === 7) openKeyboard();
+        });
+    }
+    keyboard.addEventListener('click', openKeyboard);
+    input.addEventListener('focus', () => { releaseAll(); setEditing(true); });
+    input.addEventListener('input', () => {
+        if (!fieldToken) return;
+        // This legacy client's text renderer and protocol use single-byte text.
+        const value = input.value.replace(/[^\x20-\x7E]/g, '');
+        if (input.value !== value) input.value = value;
+        call('maple_mobile_text', ['number', 'string'], [fieldToken, value]);
+    });
+    document.getElementById('mobile-next').addEventListener('click', () => {
+        command(1);
+        openKeyboard();
+    });
+    editor.addEventListener('submit', event => {
+        event.preventDefault();
+        command(0);
+        if (fieldToken && editing) openKeyboard();
+    });
+    document.getElementById('mobile-hide').addEventListener('click', () => setEditing(false));
+
+    // GLFW installs window keyboard listeners. Stop native input events before
+    // they reach it, otherwise each character is inserted into the game twice
+    // and Backspace/Tab lose their normal browser behavior.
+    for (const type of ['keydown', 'keyup', 'keypress']) {
+        window.addEventListener(type, event => {
+            if (event.target !== input) return;
+            event.stopImmediatePropagation();
+            if (type === 'keydown' && event.key === 'Enter') {
+                event.preventDefault();
+                command(0);
+            } else if (type === 'keydown' && event.key === 'Escape') {
+                event.preventDefault();
+                setEditing(false);
+            } else if (type === 'keydown' && event.key === 'Tab') {
+                event.preventDefault();
+                command(1);
+            }
+        }, true);
+    }
+    window.addEventListener('blur', releaseAll);
+    window.addEventListener('pagehide', releaseAll);
+    document.addEventListener('visibilitychange', () => { if (document.hidden) releaseAll(); });
+    window.addEventListener('resize', () => { releaseAll(); updateViewport(); });
+    if (window.visualViewport) window.visualViewport.addEventListener('resize', updateViewport);
+    updateViewport();
+})();
