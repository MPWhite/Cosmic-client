diff --git a/tests/character_stats_packet_test.cpp b/tests/character_stats_packet_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/character_stats_packet_test.cpp
@@ -0,0 +1,67 @@
+#include "support/packet_fixture.h"
+#include "client/Net/Handlers/Helpers/LoginParser.h"
+
+#include <limits>
+
+using namespace jrc;
+using test_support::PacketFixture;
+
+namespace
+{
+    PacketFixture character_stats(uint8_t level, int32_t exp)
+    {
+        PacketFixture packet;
+        for (const char c : std::string("Admin"))
+            packet.write_byte(c);
+        packet.skip(8); // Character names occupy exactly 13 bytes.
+        packet.write_byte(0); // Gender.
+        packet.write_byte(0); // Skin.
+        packet.write_int(20000); // Face.
+        packet.write_int(30000); // Hair.
+        for (int i = 0; i < 3; ++i)
+            packet.write_long(0); // Pet IDs.
+        packet.write_byte(static_cast<int8_t>(level));
+        packet.write_short(410); // Assassin.
+        for (const int16_t stat : {4, 25, 4, 400, 2714, 3892, 2154, 2327, 181, 0})
+            packet.write_short(stat);
+        packet.write_int(exp);
+        packet.write_short(12); // Fame.
+        packet.write_int(0); // Gachapon EXP.
+        packet.write_int(103000000); // Kerning City.
+        packet.write_byte(3); // Portal.
+        packet.write_int(0); // Timestamp.
+        return packet;
+    }
+}
+
+TEST_CASE("Character snapshots preserve unsigned levels across the signed-byte boundary")
+{
+    for (const uint16_t level : {1, 127, 128, 129, 199, 200, 255})
+    {
+        CAPTURE(level);
+        const auto packet = character_stats(static_cast<uint8_t>(level), 23'369'058);
+        auto input = packet.input();
+        const auto stats = LoginParser::parse_stats(input);
+        CHECK(stats.stats[Maplestat::LEVEL] == level);
+        CHECK(stats.exp == 23'369'058);
+        CHECK(stats.stats[Maplestat::JOB] == 410);
+        CHECK(stats.stats[Maplestat::HP] == 2714);
+        CHECK(stats.stats[Maplestat::AP] == 181);
+        CHECK(stats.mapid == 103000000);
+        CHECK(stats.portal == 3);
+        CHECK_FALSE(input.available());
+    }
+}
+
+TEST_CASE("High-level character EXP retains the full positive 32-bit wire value")
+{
+    for (const int32_t exp : {0, 23'369'058, 1'697'576'959, std::numeric_limits<int32_t>::max()})
+    {
+        CAPTURE(exp);
+        const auto packet = character_stats(200, exp);
+        auto input = packet.input();
+        const auto stats = LoginParser::parse_stats(input);
+        CHECK(stats.exp == exp);
+        CHECK_FALSE(input.available());
+    }
+}
