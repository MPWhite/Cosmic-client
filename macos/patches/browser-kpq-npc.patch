+
+TEST_CASE("KPQ services remain reachable alongside Lakelis record quests")
+{
+    test_support::InventoryFixture inventory_state;
+    test_support::NxFile npc_file("Npc.nx", nl::nx::npc);
+    test_support::NxFile strings("String.nx", nl::nx::string);
+    test_support::NxFile quest_file("Quest.nx", nl::nx::quest);
+    const jrc::Inventory inventory;
+    const jrc::Questlog quests;
+    using Conversation = jrc::QuestConversation;
+
+    for (int32_t id : {9020000, 9020001, 9020002})
+    {
+        jrc::Npc npc(id, 42, false, 0, false, {400, 350});
+        CHECK_MESSAGE(npc.isscripted(), "KPQ entry, stage and exit scripts must be available with all asset revisions");
+    }
+
+    jrc::Npc lakelis(9020000, 42, false, 0, false, {400, 350});
+    const auto conversation = Conversation::build(9020000, lakelis.isscripted(), quests, 25, 200, inventory, 103000000);
+    REQUIRE_MESSAGE(!conversation.options.empty(), "The real assets must expose the KPQ record quest");
+    CHECK(conversation.route() == Conversation::Route::MENU);
+    CHECK(conversation.options.back().action == Conversation::Action::TALK);
+    CHECK(std::any_of(conversation.options.begin(), conversation.options.end(), [](const auto& option) {
+        return option.action != Conversation::Action::TALK;
+    }));
+
+    // NPCs with no available quests retain normal direct service routing.
+    CHECK(Conversation::build(9020001, true, quests, 25, 200, inventory, 103000800).route() == Conversation::Route::NPC);
+}
