@@ -0,0 +1,13 @@
+#pragma once
+
+#include <cstdint>
+
+namespace jrc::NpcServices
+{
+    // These server NPC scripts also exist in asset revisions without script
+    // metadata. Their party-quest service must stay reachable beside record quests.
+    constexpr bool has_kpq_service(int32_t npcid)
+    {
+        return npcid == 9020000 || npcid == 9020001 || npcid == 9020002;
+    }
+}
