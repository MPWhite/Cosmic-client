+
+namespace
+{
+    using namespace jrc;
+    struct Label { std::string text; Point<int16_t> at; Point<int16_t> size; };
+    struct Fill { Rectangle<int16_t> bounds; float red, blue, alpha; };
+    std::vector<Label> labels;
+    std::vector<Fill> fills;
+
+    struct Assets
+    {
+        test_support::NxFile ui{"UI.nx", nl::nx::ui};
+        test_support::NxFile item{"Item.nx", nl::nx::item};
+        test_support::NxFile character{"Character.nx", nl::nx::character};
+        test_support::NxFile skill{"Skill.nx", nl::nx::skill};
+        test_support::NxFile string{"String.nx", nl::nx::string};
+    };
+
+    void clear_draws()
+    {
+        test_support::draws.clear(); labels.clear(); fills.clear();
+        Constants::set_viewsize(800, 600);
+    }
+
+    bool drew(nl::node asset)
+    {
+        const auto id = asset.get_bitmap().id();
+        return std::any_of(test_support::draws.begin(), test_support::draws.end(),
+            [&](const auto& draw) { return draw.bitmap.id() == id; });
+    }
+
+    void check_frame()
+    {
+        REQUIRE(fills.size() >= 6);
+        const auto& panel = fills[0].bounds;
+        CHECK(panel.l() >= 0); CHECK(panel.t() >= 0);
+        CHECK(panel.r() <= 800); CHECK(panel.b() <= 600);
+        CHECK(fills[1].blue > fills[1].red);
+        CHECK(fills[1].alpha >= 0.85f);
+        CHECK(fills[1].alpha < 1.0f);
+        for (const auto& label : labels)
+        {
+            CHECK(label.at.x() >= panel.l() - 1);
+            CHECK(label.at.y() >= panel.t() - 1);
+            CHECK(label.at.x() + label.size.x() <= panel.r());
+            CHECK(label.at.y() + label.size.y() <= panel.b());
+        }
+        REQUIRE(drew(nl::nx::ui["UIWindow.img"]["IconBase"]["0"]));
+        for (const auto& draw : test_support::draws)
+        {
+            CHECK(draw.bounds.l() >= panel.l() - 1);
+            CHECK(draw.bounds.t() >= panel.t() - 1);
+            CHECK(draw.bounds.r() <= panel.r());
+            CHECK(draw.bounds.b() <= panel.b());
+        }
+    }
+
+    CharStats character(uint16_t job, uint16_t level, uint16_t amount)
+    {
+        StatsEntry entry{};
+        entry.stats.clear();
+        entry.stats[Maplestat::JOB] = job;
+        entry.stats[Maplestat::LEVEL] = level;
+        for (auto stat : {Maplestat::STR, Maplestat::DEX, Maplestat::INT, Maplestat::LUK})
+            entry.stats[stat] = amount;
+        CharStats result(entry);
+        for (auto stat : {Equipstat::STR, Equipstat::DEX, Equipstat::INT, Equipstat::LUK})
+            result.set_total(stat, amount);
+        return result;
+    }
+}
+
+namespace jrc
+{
+    Sound::Sound() : id(0) {}
+    Sound::Sound(nl::node) : id(0) {}
+    GraphicsGL::GraphicsGL() : locked(false) {}
+    void GraphicsGL::addbitmap(const nl::bitmap&) {}
+    void GraphicsGL::draw(const nl::bitmap& bitmap, const Rectangle<int16_t>& rect, const Color&, float)
+    { test_support::draws.push_back({bitmap, rect}); }
+    void GraphicsGL::draw_clipped(const nl::bitmap&, const Rectangle<int16_t>&, const Color&, Range<int16_t>) {}
+    void GraphicsGL::drawrectangle(int16_t x, int16_t y, int16_t w, int16_t h, float red, float, float blue, float alpha)
+    { fills.push_back({{x, static_cast<int16_t>(x + w), y, static_cast<int16_t>(y + h)}, red, blue, alpha}); }
+    Text::Layout GraphicsGL::createlayout(const std::string& text, Text::Font, Text::Alignment, int16_t maxwidth, bool)
+    {
+        const int16_t limit = maxwidth ? maxwidth : 800;
+        int16_t x = 0, width = 0, height = text.empty() ? 0 : 14;
+        for (size_t i = 0; i < text.size(); ++i)
+        {
+            if (text[i] == '\\' && i + 1 < text.size() && (text[i + 1] == 'n' || text[i + 1] == 'r'))
+            { width = std::max(width, x); x = 0; height += 14; ++i; continue; }
+            if (x + 6 > limit) { width = std::max(width, x); x = 0; height += 14; }
+            x += 6;
+        }
+        width = std::max(width, x);
+        return {{}, std::vector<int16_t>(text.size() + 1), width, height, x, height};
+    }
+    void GraphicsGL::drawtext(const DrawArgument& args, const std::string& text, const Text::Layout& layout,
+        Text::Font, Text::Color, Text::Background, const Range<int16_t>*)
+    { if (!text.empty()) labels.push_back({text, args.getpos(), layout.get_dimensions()}); }
+}
+
+TEST_CASE("Classic item and skill tooltips use an inset icon and fit the viewport")
+{
+    Assets assets;
+    ItemTooltip item;
+    REQUIRE(item.set_item(2000002));
+    clear_draws(); item.draw({799, 599}); check_frame();
+    CHECK(labels.front().text == "White Potion");
+    CHECK(fills[0].bounds.r() - fills[0].bounds.l() == 288);
+
+    SkillTooltip skill;
+    skill.set_skill(1000002, 0, 8, -1);
+    clear_draws(); skill.draw({799, 599}); check_frame();
+    CHECK(labels.front().text == "Endure");
+    CHECK(fills[0].bounds.r() - fills[0].bounds.l() == 300);
+}
+
+TEST_CASE("Classic equipment requirements use original red and white glyphs with actual stats")
+{
+    Assets assets;
+    const int32_t id = 1472053;
+    const auto& data = EquipData::get(id);
+    REQUIRE(data);
+    EnumMap<Equipstat::Id, uint16_t> stats;
+    for (Equipstat::Id stat = Equipstat::STR; stat <= Equipstat::JUMP; stat = static_cast<Equipstat::Id>(stat + 1))
+        stats[stat] = std::max<int16_t>(0, data.get_defstat(stat));
+    Equip equip(id, 0, "", 0, data.get_slots(), 0, stats, 0, 0, 0);
+    EquipTooltip tooltip;
+    auto poor = character(100, 1, 4);
+    tooltip.set_equip(equip, poor);
+    clear_draws(); tooltip.draw({799, 599}); check_frame();
+    CHECK(fills[0].bounds.r() - fills[0].bounds.l() == 240);
+    const auto source = equipment_tooltip_assets(nl::nx::ui);
+    CHECK(drew(source["Cannot"]["reqLEV"]));
+    CHECK(drew(source["Cannot"]["reqDEX"]));
+    CHECK(std::none_of(labels.begin(), labels.end(), [](const auto& label)
+        { return label.text.find("HAMMERS") != std::string::npos; }));
+    auto eligible = character(400, 200, 999);
+    tooltip.set_equip(equip, eligible);
+    clear_draws(); tooltip.draw({0, 0}); check_frame();
+    CHECK(drew(source["Can"]["reqLEV"]));
+    CHECK(drew(source["Can"]["reqDEX"]));
+    CHECK(drew(source["Can"]["thief"]));
+    CHECK(std::any_of(labels.begin(), labels.end(), [&](const auto& label)
+        { return label.text == "WEAPON ATTACK : " + std::to_string(stats[Equipstat::WATK]); }));
+}
