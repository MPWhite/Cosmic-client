+        graphics.drawrectangle(x + 1, y + 1, width - 2, height - 2, 0.20f, 0.20f, 0.36f, 0.90f);
+        graphics.drawrectangle(x + 1, y, width - 2, 1, 0.80f, 0.80f, 0.90f, 0.95f);
+        graphics.drawrectangle(x, y + 1, 1, height - 2, 0.80f, 0.80f, 0.90f, 0.95f);
+        graphics.drawrectangle(x + 1, y + height - 1, width - 2, 1, 0.65f, 0.65f, 0.78f, 0.95f);
+        graphics.drawrectangle(x + width - 1, y + 1, 1, height - 2, 0.65f, 0.65f, 0.78f, 0.95f);
+        return position;
+    }
+
+    void Tooltip::draw_icon(const Texture& icon, Point<int16_t> position)
+    {
+        const Texture inset(nl::nx::ui["UIWindow.img"]["IconBase"]["0"]);
+        inset.draw({position + inset.get_origin(), position + inset.get_origin(),
+            Point<int16_t>(64, 64), 1.0f, 1.0f, Color(0.75f, 0.75f, 0.84f, 1.0f), 0.0f});
+        if (!icon.is_valid()) return;
+        const float scale = std::min(2.0f, 60.0f / std::max(icon.width(), icon.height()));
+        const Point<int16_t> top_left(
+            (64 - static_cast<int16_t>(icon.width() * scale)) / 2,
+            (64 - static_cast<int16_t>(icon.height() * scale)) / 2);
+        const auto origin = icon.get_origin();
+        const Point<int16_t> anchor(static_cast<int16_t>(origin.x() * scale),
+                                    static_cast<int16_t>(origin.y() * scale));
+        icon.draw({position + top_left + anchor, scale, scale});
+    }
+
+    void Tooltip::draw_separator(Point<int16_t> position, int16_t width)
+    {
+        GraphicsGL::get().drawrectangle(position.x(), position.y(), width, 1,
+            0.80f, 0.80f, 0.90f, 0.35f);
+    }
+}
