+TEST_CASE("NPC shop rejections display mesos inventory stock and exchange failures")
+{
+    test_support::NxFile ui("UI.nx", nl::nx::ui);
+    const std::vector<std::pair<int, std::string>> errors = {
+        {1, "There are not enough items in stock."},
+        {2, "You do not have enough mesos to buy this item."},
+        {3, "Your inventory is full. Make room before buying this item."},
+        {5, "There are not enough items in stock."},
+        {13, "You do not have enough of the required items."},
+        {6, "The shop could not complete the transaction. Please try again."}
+    };
+    for (const auto& error : errors)
+    {
+        test_support::PacketFixture packet(0x132);
+        packet.write_byte(error.first);
+        auto input = packet.input();
+        ShopTransactionHandler handler;
+        static_cast<const PacketHandler&>(handler).handle(input);
+        CHECK_FALSE(input.available());
+        auto popup = UI::get().get_element<UIOk>();
+        REQUIRE(popup);
+        REQUIRE(popup->is_active());
+        rendered_text.clear();
+        popup->draw(1.0f);
+        CHECK(std::find(rendered_text.begin(), rendered_text.end(), error.second) != rendered_text.end());
+        popup->send_key(KeyAction::RETURN, true, false);
+        for (int code : {0, 8})
+        {
+            test_support::PacketFixture success(0x132);
+            success.write_byte(code);
+            auto response = success.input();
+            static_cast<const PacketHandler&>(handler).handle(response);
+            CHECK_FALSE(popup->is_active());
+        }
+    }
+}
