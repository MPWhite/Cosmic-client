+TEST_CASE("NPC shop equipment and rechargeable ammo request one item or full pack")
+{
+    test_support::NxFile ui("UI.nx", nl::nx::ui);
+    test_support::NxFile items("Item.nx", nl::nx::item);
+    test_support::NxFile characters("Character.nx", nl::nx::character);
+    test_support::NxFile strings("String.nx", nl::nx::string);
+    test_support::NxFile npcs("Npc.nx", nl::nx::npc);
+    Inventory inventory;
+    CharLook look;
+    for (int32_t id : {1302000, 2070000, 2330000})
+    {
+        ShopWindow shop(look, inventory);
+        shop.reset(1031100);
+        shop.add_item(id, 500, 0, 0, 1000);
+        sent_packets.clear();
+        shop.click(13);
+        shop.click(0);
+        auto confirmation = UI::get().get_element<UIYesNo>();
+        REQUIRE(confirmation);
+        REQUIRE(confirmation->is_active());
+        confirmation->send_key(KeyAction::RETURN, true, false);
+        REQUIRE(sent_packets.size() == 1);
+        InPacket purchase(sent_packets[0].data(), sent_packets[0].size());
+        purchase.skip(5);
+        CHECK(purchase.read_int() == id);
+        CHECK(purchase.read_short() == 1);
+        CHECK_FALSE(purchase.available());
+    }
+}
