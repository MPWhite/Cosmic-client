@@ -0,0 +1,37 @@
+#include "NpcInteractionHandlers.h"
+
+#include "../../IO/UI.h"
+#include "../../IO/UITypes/UINotice.h"
+
+namespace jrc
+{
+    void ShopTransactionHandler::handle(InPacket& recv) const
+    {
+        const auto code = static_cast<uint8_t>(recv.read_byte());
+        const char* message;
+        switch (code)
+        {
+        case 0:
+        case 8:
+            // Successful purchases and sales update inventory and mesos separately.
+            return;
+        case 1:
+        case 5:
+            message = "There are not enough items in stock.";
+            break;
+        case 2:
+            message = "You do not have enough mesos to buy this item.";
+            break;
+        case 3:
+            message = "Your inventory is full. Make room before buying this item.";
+            break;
+        case 13:
+            message = "You do not have enough of the required items.";
+            break;
+        default:
+            message = "The shop could not complete the transaction. Please try again.";
+            break;
+        }
+        UI::get().emplace<UIOk>(message, [] {});
+    }
+}
