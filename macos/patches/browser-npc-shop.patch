+TEST_CASE("NPC shop Buy explains missing selection and sends the selected potion quantity")
+{
+    test_support::NxFile ui("UI.nx", nl::nx::ui);
+    test_support::NxFile items("Item.nx", nl::nx::item);
+    test_support::NxFile strings("String.nx", nl::nx::string);
+    test_support::NxFile npcs("Npc.nx", nl::nx::npc);
+    Inventory inventory;
+    CharLook look;
+    ShopWindow shop(look, inventory);
+    shop.reset(1031100);
+    shop.add_item(2000000, 50, 0, 0, 1000);
+    sent_packets.clear();
+    shop.click(0);
+    auto explanation = UI::get().get_element<UIOk>();
+    REQUIRE(explanation);
+    REQUIRE(explanation->is_active());
+    CHECK(sent_packets.empty());
+    explanation->send_key(KeyAction::RETURN, true, false);
+    shop.click(13);
+    shop.click(0);
+    auto quantity = UI::get().get_element<UIEnterNumber>();
+    REQUIRE(quantity);
+    REQUIRE(quantity->is_active());
+    REQUIRE(focused != nullptr);
+    focused->change_text("5");
+    quantity->send_key(KeyAction::RETURN, true, false);
+    REQUIRE(sent_packets.size() == 1);
+    InPacket purchase(sent_packets[0].data(), sent_packets[0].size());
+    CHECK(purchase.read_short() == 0x3d);
+    CHECK(purchase.read_byte() == 0);
+    CHECK(purchase.read_short() == 0);
+    CHECK(purchase.read_int() == 2000000);
+    CHECK(purchase.read_short() == 5);
+    CHECK_FALSE(purchase.available());
+    shop.click(0);
+    quantity = UI::get().get_element<UIEnterNumber>();
+    REQUIRE(quantity->is_active());
+    quantity->send_key(0, true, true);
+    CHECK_FALSE(quantity->is_active());
+    CHECK(sent_packets.size() == 1);
+}
