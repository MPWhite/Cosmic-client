diff --git a/tests/kpq_wall_test.cpp b/tests/kpq_wall_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/kpq_wall_test.cpp
@@ -0,0 +1,53 @@
+#include <doctest/doctest.h>
+#include "support/assets.h"
+#include "client/Gameplay/Physics/Physics.h"
+#include <cmath>
+
+TEST_CASE("KPQ stage one right wall blocks a character inside its descending endpoints")
+{
+    test_support::NxFile map("Map.nx");
+    auto source = map.root()["Map"]["Map1"]["103000800.img"]["foothold"];
+    REQUIRE(source);
+    bool found_wall = false;
+    for (auto layer : source) for (auto group : layer) for (auto node : group)
+        if (node.name() == "110")
+        {
+            found_wall = true;
+            jrc::Foothold wall(node, 110, 4);
+            CHECK(wall.x1() == 767);
+            CHECK(wall.y1() == 121);
+            CHECK(wall.y2() == -48);
+            CHECK(wall.is_blocking({71, 120}));
+            CHECK_FALSE(wall.is_blocking({-120, -70}));
+            CHECK_FALSE(wall.is_blocking({130, 180}));
+        }
+    REQUIRE(found_wall);
+}
+
+TEST_CASE("Walking to the KPQ stage one wall leaves the player able to walk back")
+{
+    test_support::NxFile map("Map.nx");
+    jrc::Physics physics(map.root()["Map"]["Map1"]["103000800.img"]["foothold"]);
+    jrc::PhysicsObject player;
+    player.set_x(740);
+    player.set_y(115);
+    player.fhid = 108;
+    for (int tick = 0; tick < 1500; ++tick)
+    {
+        if (player.onground) player.hforce = .14;
+        physics.move_object(player);
+    }
+    INFO("At right wall x=", player.crnt_x(), " y=", player.crnt_y(), " fh=", player.fhid, " grounded=",player.onground);
+    CHECK(player.crnt_x() > 760);
+    CHECK(player.crnt_x() <= 767);
+    CHECK(player.onground);
+    const auto wall_x = player.crnt_x();
+    for (int tick = 0; tick < 250; ++tick)
+    {
+        if (player.onground) player.hforce = -.14;
+        physics.move_object(player);
+    }
+    CHECK(std::isfinite(player.crnt_x()));
+    CHECK(std::isfinite(player.crnt_y()));
+    CHECK(player.crnt_x() < wall_x - 100);
+}
