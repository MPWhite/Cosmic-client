diff --git a/src/client/Gameplay/Physics/Foothold.cpp b/src/client/Gameplay/Physics/Foothold.cpp
--- a/src/client/Gameplay/Physics/Foothold.cpp
+++ b/src/client/Gameplay/Physics/Foothold.cpp
@@ -130,7 +130,10 @@
 
     bool Foothold::is_blocking(const Range<int16_t>& vertical) const
     {
-        return is_wall() && m_vertical.overlaps(vertical);
+        // WZ footholds preserve traversal direction: a right wall commonly has
+        // y1 > y2. Range::overlaps expects ascending endpoints, so compare the
+        // physical bounds without changing that direction or the linked floors.
+        return is_wall() && t() <= vertical.greater() && b() >= vertical.smaller();
     }
 
     int16_t Foothold::hdelta() const
