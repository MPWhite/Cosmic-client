     void MapChars::remove(int32_t cid)
     {
+        // Network spawn/remove packets can arrive before the next simulation
+        // update. A despawn cancels queued appearances as well as visible ones.
+        spawns.erase(std::remove_if(spawns.begin(), spawns.end(), [cid](const CharSpawn& spawn) {
+            return spawn.get_cid() == cid;
+        }), spawns.end());
         chars.remove(cid);
     }
 
     void MapChars::clear()
     {
+        // A new field must never instantiate the previous field's queued actors.
+        spawns.clear();
         chars.clear();
     }
 
