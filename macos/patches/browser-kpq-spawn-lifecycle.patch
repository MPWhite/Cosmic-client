+
+# Exercise packet ordering through the real pending-spawn and map registries.
+client_test(map_chars_lifecycle_test unit)
+target_sources(map_chars_lifecycle_test PRIVATE
+    "${CLIENT}/Gameplay/MapleMap/MapChars.cpp"
+    "${CLIENT}/Gameplay/MapleMap/MapObjects.cpp"
