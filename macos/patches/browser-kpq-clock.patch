diff --git a/src/client/Gameplay/MapleMap/FieldClockState.h b/src/client/Gameplay/MapleMap/FieldClockState.h
new file mode 100644
--- /dev/null
+++ b/src/client/Gameplay/MapleMap/FieldClockState.h
@@ -0,0 +1,60 @@
+#pragma once
+#include "../../Net/InPacket.h"
+#include "../../Net/PacketError.h"
+#include <algorithm>
+#include <cstdint>
+#include <iomanip>
+#include <sstream>
+#include <string>
+
+namespace jrc
+{
+    // Server CLOCK(147) and STOP_CLOCK(154), measured against monotonic time:
+    // rendering pauses and loading a map cannot extend an event's deadline.
+    class FieldClockState
+    {
+    public:
+        bool receive(InPacket& packet, int64_t now_ms)
+        {
+            const int type = packet.read_byte();
+            if (type == 1)
+            {
+                const int hour = packet.read_byte(), minute = packet.read_byte(), second = packet.read_byte();
+                if (hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59)
+                    throw PacketError("Invalid wall clock time");
+                origin = now_ms;
+                time_of_day = hour * 3600 + minute * 60 + second;
+                mode = WALL;
+            }
+            else if (type == 2 || type == 3)
+            {
+                if (type == 3) packet.read_byte();
+                const int32_t seconds = packet.read_int();
+                deadline = now_ms + static_cast<int64_t>(std::max(0, seconds)) * 1000;
+                mode = COUNTDOWN;
+            }
+            else return false;
+            return true;
+        }
+
+        void clear() { mode = HIDDEN; }
+        bool visible() const { return mode != HIDDEN; }
+        std::string label(int64_t now_ms) const
+        {
+            if (!visible()) return {};
+            const int64_t seconds = mode == COUNTDOWN
+                ? std::max<int64_t>(0, deadline - now_ms + 999) / 1000
+                : (time_of_day + std::max<int64_t>(0, now_ms - origin) / 1000) % (24 * 3600);
+            std::ostringstream text;
+            text << std::setfill('0');
+            if (mode == WALL) text << std::setw(2) << seconds / 3600 << ':';
+            text << std::setw(2) << (mode == WALL ? seconds / 60 % 60 : seconds / 60)
+                 << ':' << std::setw(2) << seconds % 60;
+            return text.str();
+        }
+
+    private:
+        enum Mode { HIDDEN, COUNTDOWN, WALL } mode = HIDDEN;
+        int64_t deadline = 0, origin = 0, time_of_day = 0;
+    };
+}
diff --git a/src/client/Gameplay/MapleMap/MapClock.cpp b/src/client/Gameplay/MapleMap/MapClock.cpp
new file mode 100644
--- /dev/null
+++ b/src/client/Gameplay/MapleMap/MapClock.cpp
@@ -0,0 +1,44 @@
+#include "MapClock.h"
+#include "../../Constants.h"
+#include "nlnx/nx.hpp"
+#include <chrono>
+
+namespace jrc
+{
+    namespace
+    {
+        int64_t now_ms()
+        {
+            return std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count();
+        }
+    }
+
+    void MapClock::receive(InPacket& packet)
+    {
+        if (!state.receive(packet, now_ms()) || loaded) return;
+        // Original v83 field-timer artwork, drawn natively with the map.
+        const auto artwork = nl::nx::ui["UIWindow.img"]["muruengRaid"];
+        frame = artwork["clock"]["0"];
+        colon = artwork["number"]["bar"];
+        for (int i = 0; i < 10; ++i) digits[i] = artwork["number"][std::to_string(i)];
+        loaded = true;
+    }
+
+    void MapClock::draw() const
+    {
+        if (!state.visible()) return;
+        const auto label = state.label(now_ms());
+        const Point<int16_t> center(Constants::viewwidth() / 2, 42);
+        frame.draw(center);
+        int width = 0;
+        for (char c : label) width += c == ':' ? colon.width() : digits[c - '0'].width();
+        int16_t x = center.x() - width / 2;
+        for (char c : label)
+        {
+            const Texture& glyph = c == ':' ? colon : digits[c - '0'];
+            glyph.draw(Point<int16_t>{x + glyph.get_origin().x(), center.y()});
+            x += glyph.width();
+        }
+    }
+}
