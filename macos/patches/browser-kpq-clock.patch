diff --git a/src/client/Net/Handlers/Helpers/FieldEffectAssets.h b/src/client/Net/Handlers/Helpers/FieldEffectAssets.h
new file mode 100644
--- /dev/null
+++ b/src/client/Net/Handlers/Helpers/FieldEffectAssets.h
@@ -0,0 +1,20 @@
+#pragma once
+#include "nlnx/node.hpp"
+#include <string>
+
+namespace jrc
+{
+    inline nl::node field_sound(nl::node sound, std::string path)
+    {
+        if (path.compare(0, 6, "Sound/") == 0) path.erase(0, 6);
+        // FIELD_EFFECT sound names are normally relative to Sound/Field.img.
+        const auto field = sound["Field.img"].resolve(path);
+        if (field.data_type() == nl::node::type::audio) return field;
+        const auto slash = path.find('/');
+        if (slash == std::string::npos) return {};
+        std::string file = path.substr(0, slash);
+        if (file.size() < 4 || file.substr(file.size() - 4) != ".img") file += ".img";
+        const auto node = sound[file].resolve(path.substr(slash + 1));
+        return node.data_type() == nl::node::type::audio ? node : nl::node{};
+    }
+}
