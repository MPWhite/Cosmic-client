diff --git a/tests/field_clock_assets_test.cpp b/tests/field_clock_assets_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/field_clock_assets_test.cpp
@@ -0,0 +1,37 @@
+#include <doctest/doctest.h>
+#include "support/assets.h"
+#include "client/Net/Handlers/Helpers/FieldEffectAssets.h"
+#include "nlnx/bitmap.hpp"
+
+TEST_CASE("The v83 field clock has its original frame, all digits, and colon")
+{
+    test_support::NxFile ui("UI.nx");
+    const auto art = ui.root()["UIWindow.img"]["muruengRaid"];
+    REQUIRE(art["clock"]["0"].data_type() == nl::node::type::bitmap);
+    CHECK(art["clock"]["0"].get_bitmap().width() == 205);
+    CHECK(art["clock"]["0"].get_bitmap().height() == 53);
+    for (int i = 0; i < 10; ++i)
+    {
+        const auto digit = art["number"][std::to_string(i)];
+        CHECK(digit.data_type() == nl::node::type::bitmap);
+        CHECK(digit.get_bitmap().width() == 21);
+        CHECK(digit.get_bitmap().height() == 28);
+    }
+    CHECK(art["number"]["bar"].data_type() == nl::node::type::bitmap);
+}
+
+TEST_CASE("KPQ clear and wrong packets resolve actual v83 sounds and artwork")
+{
+    test_support::NxFile sound("Sound.nx"), map("Map.nx");
+    for (const auto* name : {"Clear", "Failed"})
+    {
+        CHECK(jrc::field_sound(sound.root(), std::string("Party1/") + name).data_type() == nl::node::type::audio);
+        CHECK(jrc::field_sound(sound.root(), std::string("Sound/Field.img/Party1/") + name).data_type() == nl::node::type::audio);
+    }
+    CHECK_FALSE(jrc::field_sound(sound.root(), "Party1/missing"));
+    for (const auto* name : {"clear", "wrong_kor"})
+    {
+        const auto art = map.root()["Effect.img"]["quest"]["party"][name];
+        REQUIRE(art["0"].data_type() == nl::node::type::bitmap);
+    }
+}
diff --git a/tests/field_clock_test.cpp b/tests/field_clock_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/field_clock_test.cpp
@@ -0,0 +1,84 @@
+#include "support/packet_fixture.h"
+#include "client/Gameplay/MapleMap/FieldClockState.h"
+#include "client/Net/PacketError.h"
+
+using jrc::FieldClockState;
+using test_support::PacketFixture;
+
+TEST_CASE("Server CLOCK countdown follows elapsed time rather than rendered frames")
+{
+    PacketFixture packet(147);
+    packet.write_byte(2);
+    packet.write_int(1800);
+    auto input = packet.input();
+    FieldClockState clock;
+    REQUIRE(clock.receive(input, 10'000));
+    CHECK(clock.visible());
+    CHECK(clock.label(10'000) == "30:00");
+    CHECK(clock.label(10'999) == "30:00");
+    CHECK(clock.label(11'000) == "29:59");
+    CHECK(clock.label(75'000) == "28:55"); // Includes a paused renderer/tab.
+    CHECK(clock.label(1'810'000) == "00:00");
+    CHECK(clock.label(1'900'000) == "00:00");
+    CHECK_FALSE(input.available());
+}
+
+TEST_CASE("Stage transitions replace the clock with the server's remaining time")
+{
+    PacketFixture start(147);
+    start.write_byte(2);
+    start.write_int(1800);
+    FieldClockState clock;
+    auto first = start.input();
+    REQUIRE(clock.receive(first, 0));
+    clock.clear(); // SET_FIELD clears old map UI before its CLOCK packet arrives.
+    CHECK_FALSE(clock.visible());
+    PacketFixture next(147);
+    next.write_byte(2);
+    next.write_int(1700);
+    auto input = next.input();
+    REQUIRE(clock.receive(input, 100'000));
+    CHECK(clock.label(100'000) == "28:20");
+    CHECK(clock.label(101'000) == "28:19");
+    clock.clear(); // STOP_CLOCK154 at clear/exit.
+    CHECK_FALSE(clock.visible());
+    CHECK(clock.label(102'000).empty());
+    clock.clear();
+    CHECK_FALSE(clock.visible());
+}
+
+TEST_CASE("Wall clocks roll through midnight and type3 consumes its extra byte")
+{
+    FieldClockState clock;
+    PacketFixture wall(147);
+    wall.write_byte(1); wall.write_byte(23); wall.write_byte(59); wall.write_byte(59);
+    auto time = wall.input();
+    REQUIRE(clock.receive(time, 0));
+    CHECK(clock.label(999) == "23:59:59");
+    CHECK(clock.label(1000) == "00:00:00");
+    PacketFixture special(147);
+    special.write_byte(3); special.write_byte(0); special.write_int(61);
+    auto countdown = special.input();
+    REQUIRE(clock.receive(countdown, 2000));
+    CHECK(clock.label(2000) == "01:01");
+    CHECK_FALSE(countdown.available());
+}
+
+TEST_CASE("Truncated clock packets leave the previous server deadline intact")
+{
+    FieldClockState clock;
+    PacketFixture start(147);
+    start.write_byte(2); start.write_int(60);
+    auto valid = start.input();
+    REQUIRE(clock.receive(valid, 0));
+    PacketFixture broken(147);
+    broken.write_byte(2); broken.write_short(30);
+    auto input = broken.input();
+    CHECK_THROWS_AS(clock.receive(input, 10'000), jrc::PacketError);
+    CHECK(clock.label(10'000) == "00:50");
+    PacketFixture unknown(147);
+    unknown.write_byte(127);
+    auto other = unknown.input();
+    CHECK_FALSE(clock.receive(other, 10'000));
+    CHECK(clock.label(10'000) == "00:50");
+}
