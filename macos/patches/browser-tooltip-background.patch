 #pragma once
 #include "../../Template/Point.h"
+#include "../../Constants.h"
+#include "../../Graphics/Geometry.h"
 
+#include <algorithm>
 #include <cstdint>
 
 
@@ -43,5 +46,22 @@
         virtual ~Tooltip() = default;
 
         virtual void draw(Point<int16_t> cursorpos) const = 0;
+
+    protected:
+        static Point<int16_t> draw_background(Point<int16_t> position, int16_t width, int16_t height)
+        {
+            position.shift({12, 18});
+            position.set_x(std::clamp<int16_t>(position.x(), 0,
+                std::max<int16_t>(0, Constants::viewwidth() - width)));
+            position.set_y(std::clamp<int16_t>(position.y(), 0,
+                std::max<int16_t>(0, Constants::viewheight() - height)));
+
+            // Classic v83 has no UIToolTip.img frames. Always back the content
+            // with an opaque panel so missing or translucent skins stay readable.
+            ColorBox(width, height, Geometry::WHITE, 0.7f).draw(position);
+            ColorBox(width - 2, height - 2, Geometry::BLACK, 1.0f)
+                .draw(position + Point<int16_t>(1, 1));
+            return position;
+        }
     };
 }
